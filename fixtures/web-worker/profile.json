{
  "schema": "kiln.web-worker.v1",
  "project_id": "reviewed-example",
  "repository_path": "/srv/kiln/repositories/reviewed-example",
  "service_origin": "https://kiln.example.invalid:9443",
  "token_file": "/run/kiln-worker/worker.token",
  "tls_ca_path": "/run/kiln-worker/service-ca.pem",
  "work_root": "/var/lib/kiln-worker/jobs",
  "snapshot_limits": {
    "max_entries": 65536,
    "max_path_bytes": 4096,
    "max_file_bytes": 16777216,
    "max_total_bytes": 268435456
  },
  "command_timeout_ms": 900000,
  "maximum_output_bytes": 1048576,
  "teardown_timeout_ms": 2000,
  "poll_interval_ms": 10,
  "http_timeout_ms": 10000,
  "lookup_timeout_ms": 10000,
  "maximum_response_bytes": 1048576,
  "maximum_artifact_bytes": 16777216,
  "maximum_total_artifact_bytes": 67108864,
  "maximum_artifacts": 32,
  "steps": [
    {
      "node_id": "build",
      "program": "/bin/sh",
      "argv": ["ci/build.sh"],
      "environment": {"PATH": "/usr/bin:/bin"},
      "artifacts": ["out/build-report.json"]
    }
  ]
}
