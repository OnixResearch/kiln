  ],
  "plc_directory_url": "https://plc.directory",
  "repositories": [
    {
      "approvers": [
        "did:plc:approver234567abcdefghij"
      ],
      "clone_url": "https://knot.example.com/did:plc:abcdefghijklmnopqrstuvwx",
      "knot_did": "did:web:knot.example.com",
