  "proposed_correspondence": [
    {
      "proposed_by": "cairn-typed-requirements-author",
      "rationale": "Finite exact equality of independently supplied repository verification contract identities, including required-set, command and prerequisite identities. Missing repository contract is distinguished from self-authored passing rows. INFORMAL REMAINDER: Repository ownership/authenticity, canonicalization implementation, cryptographic hash syntax/collision resistance, arbitrary registry size, command execution and full diagnostic classes remain outside this finite interpretation.",
      "requirement_id": "cairn.supersede.agent_run_receipts.verification_contract"
    },
    {
      "proposed_by": "cairn-typed-requirements-author",
      "rationale": "Exactly one present eligible passed result per selected required check in the declared finite universe, with no unknown result rows. A duplicate passed row is not equivalent to one passed row. INFORMAL REMAINDER: The eligible observation summarizes existing native validation rather than proving it: prerequisite graph traversal, argv/digest validation and external evidence truth remain informal. The model covers at most two result slots and two known checks, not arbitrary cardinalities.",
      "requirement_id": "cairn.supersede.agent_run_receipts.pass_only"
    },
    {
      "proposed_by": "cairn-typed-requirements-author",
      "rationale": "Equality of selected finite result, contract, aggregate receipt and final post-mutation subject identities. A changed final subject distinguishes stale from current evidence. INFORMAL REMAINDER: Filesystem subject measurement, mutation ordering, command/evidence/artifact hash syntax, hash authenticity and arbitrary result universes are not established by token equality.",
      "requirement_id": "cairn.supersede.agent_run_receipts.freshness"
    },
    {
      "proposed_by": "cairn-typed-requirements-author",
      "rationale": "Authoritative completion assertion requires a present current passing native receipt for the final subject and all selected finite checks; successful prose/process observations cannot replace these fields. INFORMAL REMAINDER: Receipt origin/authenticity, schema/receipt-hash validation implementation, wrapper honesty, policy correctness, arbitrary check sets and broader release authority remain outside the finite model.",
      "requirement_id": "cairn.supersede.agent_run_receipts.completion_authority"
    },
    {
      "proposed_by": "cairn-typed-requirements-author",
      "rationale": "Single admitted claim revision changes the exact review epoch, resets lifecycle to open (so a prior discharge is not inherited), and preserves the selected finite operation history. INFORMAL REMAINDER: Current WorkflowState does not carry individual claim-root fields on every evidence link, finding and decision. That stronger prose portion is not established here; per-fact root binding, retained full claim payloads, authorized complete-basis revision admission, concurrent heads, numeric increment/overflow and arbitrary history remain informal.",
      "requirement_id": "cairn.verification_obligation_cob.claim_revision"
    }
  ],
