{
  "profile": {
    "bounds": {
      "max_attempts_per_run": 1,
      "max_encoded_bytes": 65536,
      "max_event_records": 4,
      "max_log_bytes": 4,
      "max_log_segments": 2,
      "max_log_window_bytes": 64,
      "max_metrics_per_attempt": 1,
      "max_page_items": 2,
      "max_products_per_attempt": 1,
      "max_text_bytes": 256,
      "review": {
        "max_review_changes": 16,
        "max_review_patch_sets": 16,
        "max_review_suggestions_per_change": 16,
        "max_review_window_ms": 2592000000
      }
    },
    "non_claims": [
      "bounded observation projection does not prove transport delivery",
      "bounded observation projection does not prove live freshness",
      "bounded observation projection does not prove control execution",
      "bounded observation projection does not prove provider correctness",
      "bounded observation projection does not prove CI success",
      "bounded observation projection does not establish release readiness"
    ],
    "profile_id": "observation-v1",
    "redaction": {
      "visible_fields": [
        "provider_profile",
        "external_reference",
        "products",
        "metrics",
        "command_id",
        "log_bytes",
        "suggestion_paths",
        "suggestion_owners"
      ]
    },
    "schema_version": 1,
    "views": [
      "state_summary",
      "run_list",
      "run_detail",
      "attempt_detail",
      "event_tail",
      "log_range",
      "review_friction",
      "suggestion_anchors"
    ]
  }
}
