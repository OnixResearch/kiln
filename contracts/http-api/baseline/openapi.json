  "info": {
    "description": "Bounded contract for run summary, execution-binding/artifact metadata, and reviewed runbook dispatch. This describes existing Engine::api behavior; it is not authorization, execution evidence, or a server migration.\n",
    "title": "Kiln bounded HTTP API",
    "version": "kiln.http-api.v1"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/projects": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectList"
                }
              }
            },
            "description": "Project inventory"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List available and enrolled projects"
      }
    },
    "/api/runbooks": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunbookList"
                }
              }
            },
            "description": "Reviewed runbook inventory"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List reviewed runbooks and principal dispatch eligibility"
      }
    },
    "/api/runbooks/fanouts": {
      "get": {
        "parameters": [
