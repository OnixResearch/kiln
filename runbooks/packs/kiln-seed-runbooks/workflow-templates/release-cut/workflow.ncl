let Port = { id | Number, label | String, type_tag | String } in
let Node = { id | Number, label | String, x | Number, y | Number, input_ports | Array Port, output_ports | Array Port } in
let Edge = { source | Number, target | Number } in
let EnvVar = { key | String, value | String } in
let SecretEnvVar = { name | String, provider | String, key | String, field | Array String, value | optional | Dyn } in
let ConditionBranch = { label | String, predicate | String } in
let SubworkflowInputMapping = { parent_input | String, child_input | String } in
let SubworkflowOutputMapping = { child_output | String, parent_output | String } in
let ApprovalAuthority = { profile | String, local_actors | Array String, accepted_abilities | Array String, prohibit_self_approval | Bool, delegated_policy_reference | Dyn } in
let ApprovalExpiry = { decision_ttl_millis | Number, resume_ttl_millis | Number, approval_must_be_fresh_at_resume | Bool, clock_source | String } in
let ApprovalReason = { required | Bool, identity_bound | Bool, max_bytes | Number } in
let ApprovalResumeValue = { name | String, type_tag | String } in
let ApprovalResume = { values | Array ApprovalResumeValue, credential_bindings | Array String } in
let ApprovalTerminal = { on_rejection | String, on_expiry | String } in
let ApprovalNodeConfig = { gate_id | String, safe_summary | String, selected_input_ports | Array String, required_artifacts | Array String, authority | ApprovalAuthority, expiry | ApprovalExpiry, reason | ApprovalReason, resume | ApprovalResume, terminal | ApprovalTerminal, required_non_claims | Array String } in
let NodeConfig = {
  node_id | Number,
  kind | String,
  runtime_kind | String,
  runtime_key | String,
  effect_policy | String,
  cache_policy | String,
  retry_policy | String,
  artifact_policy | String,
  command | String,
  cwd | Array String,
  env | Array EnvVar,
  secret_env | Array SecretEnvVar,
  http_method | String,
  url | String,
  headers | Array EnvVar,
  body | Array String,
  file_operation | String,
  file_path | String,
  file_content | Array String,
  overwrite | Bool,
  allowed_roots | Array String,
  image_path | String,
  image_allowed_roots | Array String,
  image_max_bytes | Number,
  agent_target | String,
  agent_prompt | String,
  agent_prompt_file | Array String,
  agent_output_mode | String,
  agent_model_hint | Array String,
  agent_tool_policy | String,
  agent_context_refs | Array String,
  agent_cwd | Array String,
  agent_session | Array String,
  condition_branches | Array ConditionBranch | default = [],
  merge_policy | String | default = "",
  merge_required_inputs | Array String | default = [],
  subworkflow_name | String | default = "",
  subworkflow_input_mappings | Array SubworkflowInputMapping | default = [],
  subworkflow_output_mappings | Array SubworkflowOutputMapping | default = [],
  approval | Array ApprovalNodeConfig | default = [],
  timeout_secs | Number,
  pipe_stdin | Bool,
}
in
let TriggerInputBinding = { input_label | String, source_kind | String, source_name | String, type_tag | String, required | Bool } in
let Trigger = {
  id | String,
  workflow_name | String,
  enabled | Bool,
  kind | String,
  webhook_method | String,
  webhook_path | String,
  webhook_content_types | Array String,
  auth_kind | String,
  auth_provider | String,
  auth_key | String,
  auth_field | Array String,
  auth_header | String,
  schedule_interval_secs | Number,
  schedule_next_run_epoch_ms | Number,
  schedule_missed_run_policy | String,
  input_bindings | Array TriggerInputBinding,
  overlap_policy | String,
  idempotency_policy | String,
  idempotency_json_pointer | String,
}
in
let Meta = { name | String, description | String, created | String, modified | String } in
let Workflow = { meta | Meta, nodes | Array Node, edges | Array Edge, configs | Array NodeConfig, triggers | Array Trigger } in
