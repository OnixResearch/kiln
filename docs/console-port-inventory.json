{
  "schema": "kiln.console-inventory.v1",
  "reference": "The current live console served by kiln-web-service: web.html, its stylesheets and scripts. It stays the visual and interaction reference and the default entry point until each cohort passes its own port gate (#68).",
  "cohorts": [
    {
      "id": "runs-shell",
      "order": 1,
      "title": "Runs pilot and shared shell"
    },
    {
      "id": "work-planning",
      "order": 2,
      "title": "Work and planning: lists, boards and interaction and evidence panels"
    },
    {
      "id": "code-review",
      "order": 3,
      "title": "Code review: diffs, revision selection, approvals and preview entry points"
    },
    {
      "id": "projects-source",
      "order": 4,
      "title": "Projects and source browsing"
    },
    {
      "id": "workers-inventories",
      "order": 5,
      "title": "Workers, inventories and readiness views"
    },
    {
      "id": "receipts-administration",
      "order": 6,
      "title": "Receipts, feeds, administration and remaining destinations"
    }
  ],
  "states": [
    "loading",
    "empty",
    "error",
    "disconnected",
    "stale",
    "unknown",
    "failed",
    "partial-retry",
    "queued",
    "running",
    "denied",
    "truncated"
  ],
  "shared_stylesheets": [
    "identity.css",
    "catalog.css",
    "web.css"
  ],
  "shell": [
    {
      "component": "brand-mark",
      "anchors": [
        "#brand-home",
        ".brand-mark"
      ],
      "owner": "web.js",
      "stylesheets": [
        "identity.css",
        "web.css"
      ],
      "preserve": "Identity red is reserved for the mark; its door is lit only from the current admitted running-work observation."
    },
    {
      "component": "navigation-rail",
      "anchors": [
        "#app-sidebar",
        ".app-rail",
        ".app-navigation",
        "#nav-ci",
        "#nav-work",
        "#rail-pin"
      ],
      "owner": "web.js",
      "stylesheets": [
        "web.css"
      ],
      "preserve": "4rem collapsed and 16rem expanded widths, hover and focus expansion, Escape collapse, the page-session pin, real anchors and the inverted current-page row."
    },
    {
      "component": "top-bar",
      "anchors": [
        ".app-topbar",
        ".topbar-location",
        ".topbar-search",
        "#connection-status",
        "#auth-status",
        "#theme-switch"
      ],
      "owner": "web.js",
      "stylesheets": [
        "web.css"
      ],
      "preserve": "3.5rem height, connection and authentication status, breadcrumb location and appearance switch."
    },
    {
      "component": "command-palette",
      "anchors": [
        "#work-command-open",
        ".command-trigger"
      ],
      "owner": "work-interaction.js",
      "stylesheets": [
        "web.css",
        "work-interaction.css"
      ],
      "runtime_classes": [
        "work-command-palette"
      ],
      "preserve": "Control+K trigger in the top bar; the palette dialog restores focus to its trigger when dismissed."
    },
    {
      "component": "page-header",
      "anchors": [
        ".page-header",
        ".kiln-rule",
        "#workspace-eyebrow",
        "#workspace-title"
      ],
      "owner": "web.js",
      "stylesheets": [
        "identity.css",
        "web.css"
      ],
      "preserve": "Section number, title and purpose read from the destination register, under the title rule."
    },
    {
      "component": "notice",
      "anchors": [
        "#notice",
        ".notice"
      ],
      "owner": "web.js",
      "stylesheets": [
        "web.css"
      ],
      "preserve": "Polite live-region status that states waiting only, never progress or success."
    },
    {
      "component": "confirmation-dialog",
      "anchors": [
        "#control-dialog",
        "#control-form",
        "#confirm-title",
        "#confirm-warning",
        "#confirm-facts",
        "#confirm-control"
      ],
      "owner": "web.js",
      "stylesheets": [
        "web.css"
      ],
      "preserve": "Alert dialog with exact consequence facts; Escape dismisses and focus returns to the invoking control."
    },
    {
      "component": "sign-in",
      "anchors": [
        "#login-panel",
        "#login-form",
        ".login-mark"
      ],
      "owner": "web.js",
      "stylesheets": [
        "web.css"
      ],
      "preserve": "Credentials are submitted only and never stored by the page."
    }
  ],
