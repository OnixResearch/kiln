{
  "components": {
    "responses": {
      "BadRequest": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Request does not match bounded API contract"
      },
      "Forbidden": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Role is not authorized"
      },
      "NotFound": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Requested resource not found"
      }
    },
    "schemas": {
      "ArtifactList": {
        "additionalProperties": false,
        "properties": {
          "artifacts": {
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "artifacts"
        ],
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "ExecutionBinding": {
        "properties": {
          "binding": {
            "type": "object"
          },
          "cancel_requested": {
            "type": "boolean"
          },
          "execution": {
            "nullable": true,
            "type": "object"
          },
          "log_bounds": {
            "$ref": "#/components/schemas/LogBounds"
          },
          "outcome": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "plan": {
            "type": "object"
          }
        },
        "required": [
          "plan",
          "binding",
          "phase",
          "outcome",
          "log_bounds"
        ],
        "type": "object"
      },
      "LogBounds": {
        "properties": {
          "maximum_chunk_bytes": {
            "type": "integer"
          },
          "maximum_chunks": {
            "type": "integer"
          },
          "maximum_total_bytes": {
            "type": "integer"
          }
        },
        "required": [
          "maximum_chunk_bytes",
          "maximum_total_bytes",
          "maximum_chunks"
        ],
        "type": "object"
      },
      "Project": {
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "pipeline_identity": {
            "description": "BLAKE3 identity of the enrolled project's workflow; present only under enrolled",
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "repository_key": {
            "type": "string"
          },
          "scope": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "repository",
          "reference",
          "repository_key"
        ],
        "type": "object"
      },
      "ProjectList": {
        "additionalProperties": false,
        "properties": {
          "available": {
            "items": {
              "$ref": "#/components/schemas/Project"
            },
            "type": "array"
          },
          "enrolled": {
            "items": {
              "$ref": "#/components/schemas/Project"
            },
            "type": "array"
          }
        },
        "required": [
          "available",
          "enrolled"
        ],
        "type": "object"
      },
      "RunPage": {
        "additionalProperties": false,
        "properties": {
          "bounded": {
            "type": "boolean"
          },
          "next_cursor": {
            "nullable": true,
            "type": "string"
          },
          "runs": {
            "items": {
              "$ref": "#/components/schemas/RunView"
            },
            "type": "array"
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "runs",
          "total",
          "bounded"
        ],
        "type": "object"
      },
      "RunView": {
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "source_revision": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "project_id",
          "source_revision",
          "outcome",
          "phase"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "GET-only contract for run summary and execution-binding/artifact metadata. This pilot describes existing Engine::api behavior; it is not authorization, execution evidence, or a server migration.\n",
    "title": "Kiln bounded HTTP API",
    "version": "kiln.http-api.v1"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/projects": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectList"
                }
              }
            },
            "description": "Project inventory"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List available and enrolled projects"
      }
    },
    "/api/runs": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "project_id",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "source_revision",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "outcome",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "order",
            "schema": {
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunPage"
                }
              }
            },
            "description": "Run page"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List runs with filtering and pagination"
      }
    },
    "/api/runs/{id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunView"
                }
              }
            },
            "description": "Run view"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Run summary"
      }
    },
    "/api/runs/{id}/artifacts": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactList"
                }
              }
            },
            "description": "Artifact metadata"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Artifact metadata list"
      }
    },
    "/api/runs/{id}/execution-binding": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutionBinding"
                }
              }
            },
            "description": "Execution binding"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Execution binding and artifact metadata"
      }
    }
  },
  "servers": [
    {
      "url": "https://localhost:9443"
    }
  ]
}
