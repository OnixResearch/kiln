# r[impl kiln.web.exploration.scenario.tailnet]
# Include inside the existing registered-user proxy's http block.
# Requires its $kiln_peer_socket map and private proxy-auth include.
map $http_origin $kiln_example_origin_allowed {
    default 0;
    "" 1;
    "https://@dns_name@:9444" 1;
}
map $http_origin $kiln_example_upstream_origin {
    default $http_origin;
    "https://@dns_name@:9444" "http://127.0.0.1:18787";
}

server {
    listen @tailnet_ipv4@:9444 ssl;
    listen [@tailnet_ipv6@]:9444 ssl;
    ssl_certificate "@certificate@";
    ssl_certificate_key "@private_key@";
    ssl_protocols TLSv1.3;
    server_name @dns_name@;
    client_max_body_size 512k;
    if ($http_host != "@dns_name@:9444") { return 403; }
    if ($kiln_example_origin_allowed = 0) { return 403; }

    location = /_kiln_example_verify {
        internal;
        proxy_pass http://127.0.0.1:8099/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host "kiln-proxy-auth";
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header Origin "";
        proxy_set_header X-Kiln-Principal "";
        proxy_set_header X-Kiln-Peer $kiln_peer_socket;
        include "@authorization_include@";
    }

    location / {
        auth_request /_kiln_example_verify;
        proxy_pass http://127.0.0.1:18787;
        proxy_http_version 1.1;
        proxy_set_header Host "127.0.0.1:18787";
        proxy_set_header Origin $kiln_example_upstream_origin;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header X-Kiln-Principal "";
        proxy_set_header X-Kiln-Peer "";
        proxy_set_header X-Kiln-Proxy-Key "";
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_next_upstream off;
        proxy_redirect off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }
}
