# @out@ is substituted with the dedicated immutable package output at install time.
# Provision the dedicated non-root account, enrollment, policy and root-private
# credential files before starting. This unit never creates credentials.
[Unit]
Description=Kiln GitHub issue polling implementer
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=kiln-implementer
Group=kiln-implementer
WorkingDirectory=/var/lib/kiln-implementer
StateDirectory=kiln-implementer
StateDirectoryMode=0700
UMask=0077
LoadCredential=github-token:/var/lib/kiln-implementer-credentials/github-token
ExecStartPre=@out@/bin/kiln-implementer status --database /var/lib/kiln-implementer/implementer.sqlite --enrollment /etc/kiln-implementer/enrollment.json
ExecStart=@out@/bin/kiln-implementer poll-run --database /var/lib/kiln-implementer/implementer.sqlite --enrollment /etc/kiln-implementer/enrollment.json --policy /etc/kiln-implementer/policy.json --secret-file /run/credentials/kiln-implementer-poll.service/github-token --max-pages 10 --timeout-ms 30000 --interval-ms 60000
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/kiln-implementer
LimitNOFILE=1024
TasksMax=64
MemoryMax=512M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
