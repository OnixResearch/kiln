    "maximum_tokens": 65536,
    "maximum_workflow_bytes": 65536,
    "maximum_workflow_files": 50,
    "maximum_workflow_polls": 3600,
    "read_timeout_ms": 3000,
    "resolver_timeout_ms": 5000,
    "worker_poll_interval_ms": 1000,
    "write_timeout_ms": 2000
